/datum/patron/godless
	name = "Godless"
	domain = "Abandonment of the Gods"
	desc = "Worship of the gods is foolish! Gods exist but you refuse to worship them due to your own hubris."
	flaws = "Stubborn, Unrelenting, Misguided"
	worshippers = "Egomaniacs, Heretics, the Ignorant"
	sins = "Idolatry, Worship, Blind Faith"
	boons = "None, you godless heathen."
	associated_faith = /datum/faith/godless
	confess_lines = list(
		"No Gods, No Masters! There is only ME!",
		"A man chooses, a slave obeys - I will be free from the Gods!",
		"The old ways WILL CRUMBLE, the gods are UNJUST!"
	)

/datum/patron/ignorant
	name = "Ignorant"
	domain = "Oblivious to the Gods"
	desc = "You do not hate or refuse to acknowledge the Gods; Somehow, you truly don't know enough to have a faith."
	flaws = "Ignorant, Clueless, Oblivious"
	worshippers = "Children, Foreigners, the Ignorant"
	sins = "Nothing in particular."
	boons = "None, you blithering idiot."
	associated_faith = /datum/faith/godless
	confess_lines = list(
		"I know nothing! Nothing, I say!",
		"Divine, Inhumen, I know none of it!",
		"I am but an ignorant fool!",
	)
